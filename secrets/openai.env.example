# Official OpenAI is the default. To use a trusted OpenAI-compatible relay,
# replace OPENAI_BASE_URL and explicitly set OPENAI_ALLOW_THIRD_PARTY=1.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ALLOW_THIRD_PARTY=0

# Routine conceptual-image model.
OPENAI_IMAGE_MODEL=gpt-image-2

# Optional final/high-resolution route. The CLI fails closed on --final/--highres
# when this is missing, unless --model is passed explicitly.
# Set this to a model name actually exposed by your official endpoint or trusted relay.
# OPENAI_IMAGE_HIGHRES_MODEL=gpt-image-2-final

OPENAI_IMAGE_QUALITY=high
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_IMAGE_OUTPUT_FORMAT=png
OPENAI_API_KEY_FILE=$HOME/.codex/secrets/openai_api_key.txt

# Example trusted relay configuration:
# OPENAI_BASE_URL=https://relay.example/v1
# OPENAI_ALLOW_THIRD_PARTY=1
# OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_IMAGE_HIGHRES_MODEL=<relay-final-quality-model-if-available>
