{
  "title": "Engineering Figure GPT Plot Request",
  "type": "object",
  "required": ["panels"],
  "properties": {
    "suptitle": {"type": "string"},
    "style": {"type": "object"},
    "layout": {"type": "object"},
    "panels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": {"enum": ["bar", "trend", "heatmap", "scatter", "legend", "empty"]},
          "title": {"type": "string"},
          "xlabel": {"type": "string"},
          "ylabel": {"type": "string"},
          "data": {"type": "object"},
          "colors": {"type": "object"},
          "source_panel": {"type": "integer", "minimum": 0},
          "annotate": {"type": "boolean"},
          "legend": {"type": "boolean"},
          "legend_outside": {"type": "boolean"},
          "grid": {"type": "boolean"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
