{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Engineering Figure GPT Normalized Plot Spec",
  "type": "object",
  "required": ["layout", "panels"],
  "properties": {
    "suptitle": {"type": "string"},
    "style": {"type": "object"},
    "layout": {
      "type": "object",
      "required": ["nrows", "ncols"],
      "properties": {
        "nrows": {"type": "integer", "minimum": 1},
        "ncols": {"type": "integer", "minimum": 1},
        "figsize": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "number", "exclusiveMinimum": 0}
        },
        "width_ratios": {
          "type": "array",
          "items": {"type": "number", "exclusiveMinimum": 0}
        },
        "height_ratios": {
          "type": "array",
          "items": {"type": "number", "exclusiveMinimum": 0}
        },
        "tight_layout_pad": {"type": "number", "minimum": 0}
      },
      "additionalProperties": true
    },
    "panels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {"enum": ["bar", "trend", "heatmap", "scatter", "legend", "empty"]},
          "title": {"type": "string"},
          "xlabel": {"type": "string"},
          "ylabel": {"type": "string"},
          "categories": {"type": "array"},
          "series": {"type": "array"},
          "labels": {"type": "array", "items": {"type": "string"}},
          "x": {"type": "array"},
          "y": {"type": "array"},
          "y_series": {"type": "array"},
          "matrix": {"type": "array"},
          "source_panel": {"type": "integer", "minimum": 0},
          "annotate": {"type": "boolean"},
          "legend": {"type": "boolean"},
          "legend_outside": {"type": "boolean"},
          "grid": {"type": "boolean"}
        },
        "allOf": [
          {
            "if": {"properties": {"type": {"const": "bar"}}},
            "then": {"required": ["categories", "series", "labels"]}
          },
          {
            "if": {"properties": {"type": {"const": "trend"}}},
            "then": {"required": ["x", "y_series", "labels"]}
          },
          {
            "if": {"properties": {"type": {"const": "heatmap"}}},
            "then": {"required": ["matrix"]}
          },
          {
            "if": {"properties": {"type": {"const": "legend"}}},
            "then": {"required": ["source_panel"]}
          }
        ],
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
