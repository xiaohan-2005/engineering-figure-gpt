{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Engineering Figure GPT Brief",
  "type": "object",
  "required": [
    "figure_goal",
    "paper_claim",
    "figure_type",
    "mode",
    "panels",
    "must_keep_labels",
    "data",
    "style_constraints",
    "output_formats",
    "verification_checklist"
  ],
  "properties": {
    "figure_goal": {
      "type": "string",
      "minLength": 1
    },
    "paper_claim": {
      "type": "string",
      "minLength": 1
    },
    "figure_type": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": ["image", "plot", "mixed"]
    },
    "panels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "content"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string"
          },
          "content": {
            "type": "string",
            "minLength": 1
          },
          "evidence_or_data": {},
          "must_keep_labels": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true
          }
        },
        "additionalProperties": true
      }
    },
    "must_keep_labels": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "data": {
      "type": "object"
    },
    "style_constraints": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "output_formats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": ["png", "pdf", "svg", "eps", "jpg", "jpeg", "tif", "tiff", "webp", "prompt-only"]
      },
      "uniqueItems": true
    },
    "verification_checklist": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    }
  },
  "additionalProperties": true
}
