{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Engineering Figure GPT Example Manifest",
  "type": "object",
  "required": ["slug", "mode", "input_artifacts", "output_artifact", "verification"],
  "properties": {
    "slug": {"type": "string", "minLength": 1},
    "mode": {"enum": ["image", "plot", "mixed"]},
    "input_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "output_artifact": {"type": "string", "minLength": 1},
    "model": {"type": "string"},
    "quality": {"type": "string"},
    "size": {"type": "string"},
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    }
  },
  "additionalProperties": true
}
